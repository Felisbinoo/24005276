#define LED 3
#define BUZZER 5

String codigo[] = { ".-", "-...", "-.-.", "-..", ".", //A-E
                   "..-.", "--.", "....", "..", ".---", //F-J
                   "-.-", ".-..", "--", "-.", "---", //K-O
                   ".--.", "--.-", ".-.", "...", "-", //P-T
                   "..-", "...-", ".--", "-..-", "-.--", "--..", //U-Z
                   "-----", ".----", "..---", "...--", "....-", ".....", "-....", "--...", "---..", "----."}; //0-9

String mensagem = "PROJETO"; //Qualquer mensagem pode ser inserida nesta parte que será devidamente codificada

void on_output (String pos);
void output_ponto();
void output_traco();
void codifica_string(String mens);

void setup(){ 
  pinMode(LED,OUTPUT);
  pinMode(BUZZER,OUTPUT);
  digitalWrite(LED,LOW);
  digitalWrite(BUZZER,LOW);
  
  codifica_string(mensagem);
}

void loop(){}

void on_output(String caractere){
  for(int i= 0; i <caractere.length(); i++){
    if(caractere[i] == '.'){
      output_ponto; 
    }
    else if(caractere[i] == '-'){
      output_traco;
    }
  }
}
void output_ponto(){ 
  digitalWrite(LED,HIGH);
  digitalWrite(BUZZER,HIGH);
  delay(100);
  digitalWrite(LED,LOW);
  digitalWrite(BUZZER,LOW);
  delay(100);
}
void output_traco(){
  digitalWrite(LED,HIGH);
  digitalWrite(BUZZER,HIGH);
  delay(300);
  digitalWrite(LED,LOW);
  digitalWrite(BUZZER,LOW);
  delay(300);
}
void codifica_string(String mens){
  int posicao_codigo;
  for(int i=0; i<mens.length();i++){
    posicao_codigo = ((int) mens[i])-65;
    on_output(codigo[posicao_codigo]);
delay(500);
 }                      
}
